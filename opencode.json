{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "nuclia": {
      "type": "remote",
      "url": "https://${NUCLIA_ZONE}.rag.progress.cloud/api/v1/kb/${NUCLIA_KB_ID}/mcp",
      "headers": {
        "X-NUCLIA-SERVICEACCOUNT": "Bearer ${NUCLIA_SERVICEACCOUNT}"
      }
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@0.0.74", "--headless"]
    }
  }
}
