# ─────────────────────────────────────────────────────────────────────────────
# Portal server environment — SERVER-SIDE ONLY.
# None of these values ever reach the browser bundle. The KB token in particular
# lives only here; it is never written to demo.config.json, /api/config, or logs.
# `.env` is gitignored. See docs/ARAG-API.md for the three credential types.
# ─────────────────────────────────────────────────────────────────────────────

# KB service-account token (a JWT, or a `kb-…` token). Sent to Nuclia as
# `X-NUCLIA-SERVICEACCOUNT: Bearer <token>`. Do NOT include the "Bearer " prefix.
NUCLIA_SERVICEACCOUNT=your-service-account-token

# Full Knowledge Box base URL, including the KB id:
#   https://<zone>.rag.progress.cloud/api/v1/kb/<kb-id>
# (Document-processing KBs use dp.progress.cloud instead of rag.progress.cloud.)
NUCLIA_KB_URL=https://europe-1.rag.progress.cloud/api/v1/kb/your-kb-id

# Zone/region (e.g. europe-1, aws-eu-1). Server-side only — NEVER rendered in the
# UI (Hard Rule 4: no residency/zone string on a customer-facing surface).
NUCLIA_ZONE=europe-1

# Optional: pin a generative model. Leave blank to use the KB default.
# Do NOT send an empty string to /ask — blank here means "omit".
NUCLIA_GENERATIVE_MODEL=

# Portal server port. Local default 4000; container default 8080.
PORT=4000
