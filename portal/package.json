{
  "name": "arag-portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The ARAG Demo Factory portal shell — one config-driven Progress Agentic RAG research portal that renders itself from demo.config.json.",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"node --watch server/index.mjs\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "kendo:license": "node scripts/kendo-license.mjs",
    "prebuild": "node scripts/kendo-license.mjs"
  },
  "dependencies": {
    "@progress/kendo-drawing": "^1.25.3",
    "@progress/kendo-licensing": "^1.11.2",
    "@progress/kendo-react-buttons": "^15.1.0",
    "@progress/kendo-react-charts": "^15.1.0",
    "@progress/kendo-react-dialogs": "^15.1.0",
    "@progress/kendo-react-dropdowns": "^15.1.0",
    "@progress/kendo-react-grid": "^15.1.0",
    "@progress/kendo-react-indicators": "^15.1.0",
    "@progress/kendo-react-inputs": "^15.1.0",
    "@progress/kendo-react-layout": "^15.1.0",
    "@progress/kendo-react-notification": "^15.1.0",
    "@progress/kendo-svg-icons": "^5.3.0",
    "@progress/kendo-theme-default": "^14.3.0",
    "express": "^4.21.2",
    "hammerjs": "^2.0.8",
    "lucide-react": "^0.344.0",
    "marked": "^12.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.2"
  }
}
