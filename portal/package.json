    "dev:api": "node --watch server/index.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "kendo:license": "node scripts/kendo-license.mjs",
