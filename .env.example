# ─────────────────────────────────────────────────────────────
# ARAG Demo Factory — environment
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill it in. `.env` is gitignored — no
# credential ever goes into git, demo.config.json, or the UI bundle. It
# lives only here (server-side) and reaches Nuclia as a Bearer header.
#
# ═══ OPTION A (recommended): give the factory a NUA key ═════════════
# A Nuclia Understanding API (NUA) key lets the factory create and manage
# its OWN ARAG assets under your account. Provide these three and Phase 1
# PROVISIONS EVERYTHING (`node scripts/create-kb.mjs`): it creates a fresh
# Knowledge Box, wires its credentials back into this file, ingests the
# generated corpus, creates labelsets + retrieval agents, and configures
# retrieval — no setup by hand.
#
#   NUCLIA_NUA_KEY  = your NUA key (create it in the Nuclia dashboard →
#                     account → NUA keys, in the zone below)
#   NUCLIA_ACCOUNT  = your account slug or id
#   NUCLIA_ZONE     = the zone the KB is created in, e.g. europe-1,
#                     aws-eu-1, aws-ap-southeast-2-1. Server-side only —
#                     Hard Rules forbid rendering the zone on a customer surface.
NUCLIA_NUA_KEY=
NUCLIA_ACCOUNT=
NUCLIA_ZONE=

# ═══ OPTION B: bind an EXISTING Knowledge Box instead ═══════════════
# If you already have a KB, set these (and leave Option A blank). The
# factory skips provisioning and binds this KB directly.
#   NUCLIA_SERVICEACCOUNT = KB service-account token (JWT or `kb-…`)
#   NUCLIA_KB_URL         = https://<zone>.rag.progress.cloud/api/v1/kb/<kbId>
#                           (doc-processing KBs use dp.progress.cloud)
#   NUCLIA_KB_ID          = the KB id (uuid)
# create-kb.mjs writes these three for you under Option A.
NUCLIA_SERVICEACCOUNT=
NUCLIA_KB_URL=
NUCLIA_KB_ID=

# ── Portal server ────────────────────────────────────────────
# Port the generated portal's Express server listens on.
# Defaults to 4000 locally / 8080 in the Fly container.
PORT=4000
