# ─────────────────────────────────────────────────────────────
# ARAG Demo Factory — environment
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill it in. `.env` is gitignored — no
# credential ever goes into git, demo.config.json, or the UI bundle. It
# lives only here (server-side) and reaches Nuclia as a Bearer header.
#
# ═══ ONE-TIME SETUP — three values, copied once from your dashboard ═
# These three ARE the whole setup. Fill them in ONCE; from then on a demo
# is a single prompt ("Build me a <use case>") and Phase 1 provisions
# EVERYTHING automatically (`node scripts/create-kb.mjs`): a fresh Knowledge
# Box, its service-account token, the corpus ingest, labelsets + retrieval
# agents, and search configurations. You never touch these again.
#
#   NUCLIA_NUA_KEY  = your NUA key — Nuclia dashboard → account → NUA keys,
#                     in the zone below. IMPORTANT: enable "Manage Knowledge
#                     Boxes" when you create it — the factory needs KB management
#                     to provision your KB (a key with it disabled fails fast).
#                     Scoped to KB + understanding/tasks (the right least-privilege
#                     key to hand to partners); it never touches the data plane.
#   NUCLIA_ACCOUNT  = your account id (the UUID) — copy it once from the
#                     dashboard (Account settings, or the dashboard URL). A
#                     NUA key cannot self-discover its account, so it is
#                     captured here once. Must be the UUID, not the slug.
#   NUCLIA_ZONE     = the zone, e.g. aws-ap-southeast-2-1, aws-eu-1,
#                     europe-1. Server-side only — Hard Rules forbid
#                     rendering the zone on a customer surface.
NUCLIA_NUA_KEY=
NUCLIA_ACCOUNT=
NUCLIA_ZONE=

# ═══ OPTION B: bind an EXISTING Knowledge Box instead ═══════════════
# If you already have a KB, set these (and leave Option A blank). The
# factory skips provisioning and binds this KB directly.
#   NUCLIA_SERVICEACCOUNT = KB service-account token (JWT or `kb-…`)
#   NUCLIA_KB_URL         = https://<zone>.rag.progress.cloud/api/v1/kb/<kbId>
#                           (doc-processing KBs use dp.progress.cloud)
#   NUCLIA_KB_ID          = the KB id (uuid)
# create-kb.mjs writes these three for you under Option A.
NUCLIA_SERVICEACCOUNT=
NUCLIA_KB_URL=
NUCLIA_KB_ID=

# ── Portal server ────────────────────────────────────────────
# Port the generated portal's Express server listens on.
# Defaults to 4000 locally / 8080 in the Fly container.
PORT=4000
