# ─────────────────────────────────────────────────────────────
# ARAG Demo Factory — environment
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your Nuclia credentials.
# `.env` and `.mcp.json` are gitignored — the KB token NEVER goes
# into git, demo.config.json, or the UI bundle. It lives only here
# (server-side) and is read by the portal's Express server as the
# `X-NUCLIA-SERVICEACCOUNT: Bearer …` header.

# ── Required: bind an existing Knowledge Box ─────────────────
# The KB service-account token (JWT or `kb-…`). Server-side only.
NUCLIA_SERVICEACCOUNT=

# Full KB base URL:
#   https://<zone>.rag.progress.cloud/api/v1/kb/<kbId>
# Doc-processing KBs use the dp.progress.cloud host instead.
NUCLIA_KB_URL=

# Zone, e.g. europe-1, aws-eu-1, aws-ap-southeast-2-1.
# Server-side only — the Hard Rules forbid rendering the zone on a
# customer-facing surface (residency safety).
NUCLIA_ZONE=

# The KB id (uuid). Used to compose MCP + REST URLs.
NUCLIA_KB_ID=

# ── Optional: only needed to CREATE new KBs (Account API) ────
# Account slug + Personal Access Token. Leave blank when binding an
# existing KB.
NUCLIA_ACCOUNT=
NUCLIA_ACCOUNT_TOKEN=

# ── Portal server ────────────────────────────────────────────
# Port the generated portal's Express server listens on.
# Defaults to 4000 locally / 8080 in the Fly container.
PORT=4000
