# ─────────────────────────────────────────────────────────────
# ARAG Demo Factory — environment
# ─────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill it in. `.env` is gitignored — the
# token NEVER goes into git, demo.config.json, or the UI bundle. It
# lives only here (server-side) and is read by the portal's Express
# server as the `X-NUCLIA-SERVICEACCOUNT: Bearer …` header.
#
# ═══ OPTION A (recommended): just give the factory an account key ═══
# Provide these three and the factory PROVISIONS ITS OWN Knowledge Box
# in Phase 1 (`node scripts/create-kb.mjs`): it creates a fresh KB,
# mints a service-account token, ingests the generated corpus, and
# configures retrieval — no KB setup by hand.
NUCLIA_ACCOUNT=
NUCLIA_ACCOUNT_TOKEN=
# Zone the KB is created in, e.g. europe-1, aws-eu-1, aws-ap-southeast-2-1.
# Server-side only — Hard Rules forbid rendering the zone on a customer surface.
NUCLIA_ZONE=

# ═══ OPTION B: bind an EXISTING Knowledge Box instead ═══════════════
# If you already have a KB, set these (and leave Option A blank). The
# factory skips provisioning and binds this KB directly.
#   NUCLIA_SERVICEACCOUNT = KB service-account token (JWT or `kb-…`)
#   NUCLIA_KB_URL         = https://<zone>.rag.progress.cloud/api/v1/kb/<kbId>
#                           (doc-processing KBs use dp.progress.cloud)
#   NUCLIA_KB_ID          = the KB id (uuid)
# create-kb.mjs writes these three for you under Option A.
NUCLIA_SERVICEACCOUNT=
NUCLIA_KB_URL=
NUCLIA_KB_ID=

# ── Optional: account NUA key for the multi-model catalogue ──────────
# Only needed for the Visibility surface's live cross-model scores.
NUCLIA_NUA_KEY=

# ── Portal server ────────────────────────────────────────────
# Port the generated portal's Express server listens on.
# Defaults to 4000 locally / 8080 in the Fly container.
PORT=4000
