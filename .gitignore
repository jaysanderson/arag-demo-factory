# Secrets — NEVER commit. The KB token lives only in .env (server-side).
.env
.env.*
!.env.example

# Kendo/Telerik license key file — a credential; never commit it (either location).
telerik-license.txt
kendo-ui-license.txt

# .mcp.json ships (env-substitution `${NUCLIA_*}` only, no literal token — read
# at runtime, same as .cursor/.vscode configs). If a tool ever resolves a token
# into it locally, do NOT commit that change.

# Dependencies
node_modules/
portal/node_modules/

# Build output
portal/dist/
dist/

# Generated corpus (synthetic, regenerated per build)
corpus/generated/

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*

# Playwright MCP snapshots / screenshots (tool artifacts)
.playwright-mcp/

# Demo recordings (large video files)
recordings/
portal/.env

# Generated by create-app.js (not shipped in the factory)
demo.config.json
portal/demo.config.json
